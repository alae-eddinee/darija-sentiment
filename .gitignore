results/*.png
results/*.jpg
results/*.jpeg

# Model checkpoints and weights
*.pkl
*.bin
*.pt
*.safetensors
models/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# Web / Next.js
web/node_modules/
web/.next/
web/out/

# Testing
.pytest_cache/
.coverage
htmlcov/
